/target
# cargo-fuzz builds in a detached workspace under fuzz/; its build dir and
# resolved lockfile are local artifacts, never committed.
/fuzz/target
/fuzz/Cargo.lock
/fuzz/corpus
/fuzz/artifacts
**/*.rs.bk
Cargo.lock.bak
.DS_Store
.idea/
.vscode/
*.pdb

# Python build artifacts
__pycache__/
.pytest_cache/
*.py[cod]
*.so
*.pyd
*.egg-info/
dist/
.venv/
build/

# Node build artifacts (index.js / index.d.ts ARE committed)
node_modules/
*.node

# WASM build artifacts
bindings/wasm/pkg/

# Go: the C ABI library is staged per-platform by CI, never committed here.
bindings/go/lib/*/

# .NET build artifacts
bin/
obj/

# Java / Maven build artifacts
bindings/java/target/

# R build artifacts
bindings/r/.rlib/
bindings/r/src/*.o
bindings/r/src/*.so
bindings/r/src/*.dll
bindings/r/..Rcheck/

# Local secrets — never commit credentials.
.env
.env.*
*.key
secrets/

# Example build output. The Java example is compiled to a directory beside it by
# the command in its own header comment, and by the `examples` CI job.
examples/java/out/
examples/c/build/

# Licence texts staged into the npm platform packages by release.yml so each
# published package carries the texts its `license` field names. Copies, not
# sources: LICENSE-MIT and LICENSE-APACHE at the root are the originals.
bindings/node/LICENSE-MIT
bindings/node/LICENSE-APACHE
bindings/node/npm/*/LICENSE-MIT
bindings/node/npm/*/LICENSE-APACHE
